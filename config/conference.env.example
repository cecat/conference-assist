# Copy to config/conference.env and fill in.
# Gitignored: this holds ids and addresses specific to your event.

# The Google Form collecting talk proposals. From its URL:
#   https://docs.google.com/forms/d/THIS_PART/edit
PROPOSAL_FORM_ID=""

# Drive folder the agent keeps its derived artifacts in.
WORKING_FOLDER="TPC27"

# The canonical FAQ document the agent answers questions from.
# See SPEC.md: the agent must not answer from anything else.
FAQ_DOC_ID=""

# Who receives drafts for approval, and who is CC-ed on auto-sent answers.
APPROVER_EMAIL=""
CC_EMAIL=""

# Registration counts sheet, maintained by registration staff.
REGISTRATION_SHEET_ID=""
